{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lgtm:schema:adapter",
  "title": "LGTM advisory adapter response contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hookSpecificOutput"
  ],
  "properties": {
    "hookSpecificOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hookEventName",
        "additionalContext"
      ],
      "properties": {
        "hookEventName": {
          "enum": [
            "SessionStart",
            "UserPromptSubmit",
            "PostToolUse"
          ]
        },
        "additionalContext": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
