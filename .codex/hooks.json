{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/home/ubuntu/.local/bin/lgtm hook permission-request --adapter codex",
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Edit|Write|exec_command|unified_exec|Bash)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/home/ubuntu/.local/bin/lgtm hook post-tool-use --adapter codex",
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Edit|Write|exec_command|unified_exec|Bash)$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/home/ubuntu/.local/bin/lgtm hook pre-tool-use --adapter codex",
